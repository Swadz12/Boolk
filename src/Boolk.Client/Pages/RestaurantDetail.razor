@page "/restaurant/{RestaurantId:guid}"
@inject RestaurantDetailViewModel VM
@implements IDisposable

<PageTitle>Restaurant Details - Boolk</PageTitle>

@if (VM.Restaurant == null && !VM.IsLoading)
{
    <div class="container mt-5">
        <div class="card">
            <div style="text-align: center; padding: 3rem;">
                <div style="font-size: 4rem; margin-bottom: 1rem;">🔍</div>
                <h3 style="margin-bottom: 1rem;">Restaurant not found</h3>
                <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                    The restaurant you're looking for doesn't exist.
                </p>
                <a href="/restaurants" class="btn btn-primary">Browse Restaurants</a>
            </div>
        </div>
    </div>
}
else if (VM.IsLoading)
{
    <div class="container mt-5">
        <div class="card">
            <div style="text-align: center; padding: 3rem;">
                <div class="spinner"></div>
                <p style="margin-top: 1rem; color: var(--text-secondary);">Loading restaurant details...</p>
            </div>
        </div>
    </div>
}
else if (VM.Restaurant != null)
{
    <div class="hero" style="padding: 2rem;">
        <div class="hero-content">
            <h1 style="font-size: 2.5rem;">@VM.Restaurant.Name</h1>
            <p>📍 @VM.Restaurant.City</p>
        </div>
    </div>

    <div class="container mt-5">
        <div class="grid grid-2 mb-5">
            <div class="card fade-in">
                <div class="card-header">
                    <h2 class="card-title">ℹ️ Restaurant Information</h2>
                </div>
                <div style="padding: 1rem;">
                    <div style="margin-bottom: 1.5rem;">
                        <div style="font-size: 3rem; text-align: center; margin-bottom: 1rem;">
                            @VM.Restaurant.DisplayIcon
                        </div>
                        <div style="text-align: center;">
                            <span class="restaurant-type">@VM.Restaurant.DisplayIcon @VM.Restaurant.DisplayName</span>
                        </div>
                    </div>
                    <div style="padding: 1rem; background: var(--glass-bg); border-radius: 12px; margin-bottom: 1rem;">
                        <div style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.5rem;">Restaurant ID</div>
                        <div style="font-family: monospace; font-size: 0.85rem;">@VM.Restaurant.Id</div>
                    </div>
                    <div style="padding: 1rem; background: var(--glass-bg); border-radius: 12px;">
                        <div style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.5rem;">Location</div>
                        <div style="font-weight: 600;">📍 @VM.Restaurant.City</div>
                    </div>
                </div>
            </div>

            <div class="card fade-in" style="animation-delay: 0.1s">
                <div class="card-header">
                    <h2 class="card-title">📊 Statistics</h2>
                </div>
                <div style="padding: 1rem;">
                    <div class="stats-card" style="background: transparent; border: none; padding: 0; margin-bottom: 1.5rem;">
                        <div class="stats-number">@VM.ReviewCount</div>
                        <div class="stats-label">Total Reviews</div>
                    </div>
                    @if (VM.ReviewCount > 0)
                    {
                        <div class="stats-card" style="background: transparent; border: none; padding: 0; margin-bottom: 1.5rem;">
                            <div class="stats-number" style="font-size: 1.5rem;">€@VM.AveragePrice.ToString("F2")</div>
                            <div class="stats-label">Average Price</div>
                        </div>
                        <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                            <div class="stats-number" style="font-size: 1.5rem;">
                                @for (int i = 0; i < (int)Math.Round(VM.AverageSatiety); i++)
                                {
                                    <span class="star">⭐</span>
                                }
                            </div>
                            <div class="stats-label">Average Satiety (@VM.AverageSatiety.ToString("F1")/10)</div>
                        </div>
                    }
                    else
                    {
                        <p style="color: var(--text-secondary); text-align: center; padding: 2rem;">
                            No reviews yet
                        </p>
                    }
                </div>
            </div>
        </div>

        @if (VM.Reviews != null && VM.Reviews.Any())
        {
            <div class="card fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <h2 class="card-title">💬 Reviews (@VM.ReviewCount)</h2>
                    <a href="/reviews" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                        ➕ Add Review
                    </a>
                </div>
                <div style="padding: 1rem;">
                    @foreach (var review in VM.Reviews.OrderByDescending(r => r.Price))
                    {
                        <div @key="review.Id" class="review-card fade-in">
                            <div class="review-header">
                                <div>
                                    <div style="font-weight: 600; margin-bottom: 0.25rem;">
                                        Review #@review.Id.ToString().Substring(0, 8)...
                                    </div>
                                    <small style="color: var(--text-secondary);">
                                        User: @review.UserId.ToString().Substring(0, 8)...
                                    </small>
                                </div>
                                <div class="review-price">€@review.Price.ToString("F2")</div>
                            </div>
                            <div class="review-satiety" style="margin-bottom: 1rem;">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <span class="star" style="opacity: @(i <= review.SatietyLevel ? "1" : "0.2")">⭐</span>
                                }
                                <span style="margin-left: 0.5rem; color: var(--text-secondary);">(@review.SatietyLevel/10)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <p style="color: var(--text-primary); line-height: 1.6; font-style: italic;">
                                    "@review.Comment"
                                </p>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card fade-in"  style="margin-top: 2rem;animation-delay: 0.2s">
                <div style="text-align: center; padding: 3rem;">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">⭐</div>
                    <h3 style="margin-bottom: 1rem;">No reviews yet</h3>
                    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                        Be the first to review this restaurant!
                    </p>
                    <a href="/reviews" class="btn btn-primary">Add First Review</a>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid RestaurantId { get; set; }

    protected override void OnInitialized() => VM.OnStateChanged += StateHasChanged;
    public void Dispose() => VM.OnStateChanged -= StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAsync(RestaurantId);
    }

    protected override async Task OnParametersSetAsync()
    {
        await VM.LoadAsync(RestaurantId);
    }
}
