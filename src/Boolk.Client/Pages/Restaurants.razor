@page "/restaurants"
@inject RestaurantsViewModel VM
@implements IAsyncDisposable

<PageTitle>Restaurants - Boolk</PageTitle>

<div class="hero" style="padding: 2rem;">
    <div class="hero-content">
        <h1 style="font-size: 2.5rem;">Restaurant Directory</h1>
        <p>Add new restaurants or browse existing ones</p>
    </div>
</div>

<div class="container mt-5">
    <div class="grid grid-2">
        <div class="card fade-in">
            <div class="card-header">
                <h2 class="card-title">➕ Add New Restaurant</h2>
            </div>
            <EditForm Model="@VM.NewRestaurant" OnValidSubmit="@VM.CreateRestaurantAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" style="margin: 0.55rem; display: block;">Type:</label>
                    <InputSelect @bind-Value="VM.RestaurantType" class="form-select">
                        <option value="">Select type...</option>
                        <option value="fastfood">🍟 Fast Food</option>
                        <option value="studentbar">🍺 Student Bar</option>
                        <option value="premium">⭐ Premium</option>
                        <option value="asian">🍜 Asian </option>
                        <option value="burgers">🍔 Burgers</option>
                        <option value="sushi">🍱 Sushi</option>
                        <option value="italian">🍕 Italian</option>
                        <option value="kebab">🫔 Kebab</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="margin: 0.5rem; display: block;">Name:</label>
                    <InputText @bind-Value="VM.NewRestaurant.Name" class="form-control" placeholder="Enter restaurant name" />
                    <ValidationMessage For="@(() => VM.NewRestaurant.Name)" class="validation-message" />
                </div>
                <div class="mb-3">
                    <label class="form-label" style="margin: 0.5rem; display: block;">City:</label>
                    <InputText @bind-Value="VM.NewRestaurant.City" class="form-control" placeholder="Enter city" />
                    <ValidationMessage For="@(() => VM.NewRestaurant.City)" class="validation-message" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@VM.IsSubmitting" style="margin-top: 1rem;">
                    @if (VM.IsSubmitting)
                    {
                        <span class="spinner"></span>
                    }
                    Add Restaurant
                </button>
            </EditForm>

            @if (!string.IsNullOrEmpty(VM.Message))
            {
                <div class="alert @(VM.Message.Contains("Error") ? "alert-error" : "alert-success") mt-3">
                    @VM.Message
                </div>
            }
        </div>

        <div class="card fade-in" style="animation-delay: 0.1s">
            <div class="card-header">
                <h2 class="card-title">📊 Statistics</h2>
            </div>
            <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                <div class="stats-number">@VM.TotalRestaurants</div>
                <div class="stats-label">Total Restaurants</div>
            </div>
             <div style="margin-top: 1rem;">
                <p>Page @VM.CurrentPage of @VM.TotalPages</p>
            </div>
        </div>
    </div>

    @if (VM.Restaurants != null && VM.Restaurants.Any())
    {
        <div class="card fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h2 class="card-title">🍴 All Restaurants</h2>
                <div>
                     <button class="btn btn-secondary" @onclick="VM.PrevPageAsync" disabled="@(VM.CurrentPage == 1)" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                        ⬅️ Prev
                    </button>
                    <span style="margin: 0 1rem;">Page @VM.CurrentPage</span>
                    <button class="btn btn-secondary" @onclick="VM.NextPageAsync" disabled="@(!VM.HasMorePages)" style="padding: 0.5rem 1rem;">
                        Next ➡️
                    </button>
                    <button class="btn btn-secondary" @onclick="VM.RefreshAsync" style="padding: 0.5rem 1rem; font-size: 0.85rem; margin-left: 1rem;">
                        🔄 Refresh
                    </button>
                </div>
            </div>
            <div class="grid grid-3" style="padding: 1rem;">
                @foreach (var (restaurant, index) in VM.Restaurants.Select((r, i) => (r, i)))
                {
                    <a @key="restaurant.Id" href="/restaurant/@restaurant.Id" style="text-decoration: none; color: inherit;">
                        <div class="restaurant-card fade-in" style="@($"animation-delay: {index * 0.05}s")">
                            <h3 class="restaurant-name">@restaurant.Name</h3>
                            <p class="restaurant-city">📍 @restaurant.City</p>
                            <span class="restaurant-type">@restaurant.DisplayIcon @restaurant.DisplayName</span>
                            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--glass-border);">
                                <small style="color: var(--text-secondary);">ID: @restaurant.Id.ToString().Substring(0, 8)...</small>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
    else if (VM.Restaurants != null && !VM.Restaurants.Any())
    {
        <div class="card mt-5 fade-in" style="animation-delay: 0.2s">
             <div class="card-header" style="display: flex; justify-content: flex-end;">
                 <button class="btn btn-secondary" @onclick="VM.PrevPageAsync" disabled="@(VM.CurrentPage == 1)" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                        ⬅️ Prev
                 </button>
            </div>
            <div style="text-align: center; padding: 3rem;">
                <div style="font-size: 4rem; margin-bottom: 1rem;">🍽️</div>
                <h3 style="margin-bottom: 1rem;">No restaurants found</h3>
                <p style="color: var(--text-secondary);">
                    Try adding one or going back to the previous page.
                </p>
            </div>
        </div>
    }
</div>

@code {
    private bool _signalRStarted;

    protected override void OnInitialized() => VM.OnStateChanged += StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        VM.InvokeAsync = fn => InvokeAsync(fn);
        await VM.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_signalRStarted)
        {
            _signalRStarted = true;
            await VM.StartSignalRAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        VM.OnStateChanged -= StateHasChanged;
        await VM.DisposeAsync();
    }
}
