@page "/dashboard"
@inject DashboardViewModel VM
@implements IAsyncDisposable

<PageTitle>Dashboard - Boolk</PageTitle>

<div class="hero" style="padding: 2rem;">
    <div class="hero-content">
        <h1 style="font-size: 2.5rem;">📊 Dashboard</h1>
        <p>Overview of your restaurant ranking system</p>
    </div>
</div>

<div class="container mt-5">
    <div class="grid grid-4 mb-5">
        <div class="stats-card fade-in">
            <div class="stats-number">@VM.TotalRestaurants</div>
            <div class="stats-label">Total Restaurants</div>
        </div>
        <div class="stats-card fade-in" style="animation-delay: 0.1s">
            <div class="stats-number">@VM.TotalReviews</div>
            <div class="stats-label">Total Reviews</div>
        </div>
        <div class="stats-card fade-in" style="animation-delay: 0.2s">
            <div class="stats-number">€@VM.AveragePrice.ToString("F2")</div>
            <div class="stats-label">Avg. Price</div>
        </div>
        <div class="stats-card fade-in" style="animation-delay: 0.3s">
            <div class="stats-number">@VM.AverageSatiety.ToString("F1")</div>
            <div class="stats-label">Avg. Satiety</div>
        </div>
    </div>

    <div class="grid grid-2 mb-5">
        <div class="card fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
            <div class="card-header">
                <h2 class="card-title">🍴 Restaurant Types</h2>
            </div>
            <div style="padding: 1rem;">
                @foreach (var stat in VM.RestaurantTypeStats.OrderByDescending(x => x.Count))
                {
                    <div @key="stat.Label" style="margin-bottom: 1rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                            <span>@stat.Label</span>
                            <span style="font-weight: 600;">@stat.Count</span>
                        </div>

                        <div style="background: var(--glass-bg); border-radius: 10px; height: @(stat.BarHeight)px; overflow: hidden;">
                            <div style="
                    background: @stat.Gradient;
                    height: 100%;
                    width: @(VM.GetPercentage(stat.Count, VM.TotalRestaurants))%;
                    transition: width 0.5s ease;">
                            </div>
                        </div>
                    </div>
                }
            </div>

    </div>


        <div class="card fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
            <div class="card-header">
                <h2 class="card-title">🏆 Most Reviewed</h2>
            </div>
            <div style="padding: 1rem;">
                @if (VM.TopReviewedRestaurants != null && VM.TopReviewedRestaurants.Any())
                {
                    @foreach (var (restaurant, index) in VM.TopReviewedRestaurants.Take(5).Select((r, i) => (r, i + 1)))
                    {
                        <div @key="restaurant.Id" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; margin-bottom: 0.5rem; background: var(--glass-bg); border-radius: 12px; border: 1px solid var(--glass-border);">
                            <div>
                                <div style="font-weight: 600; margin-bottom: 0.25rem;">@restaurant.Name</div>
                                <small style="color: var(--text-secondary);">📍 @restaurant.City</small>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 1.5rem; font-weight: 700; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                                    @VM.GetReviewCount(restaurant.Id)
                                </div>
                                <small style="color: var(--text-secondary);">reviews</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="color: var(--text-secondary); text-align: center; padding: 2rem;">
                        No reviews yet
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="card fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
        <div class="card-header">
            <h2 class="card-title">⚡ Quick Rankings</h2>
        </div>
        <div style="padding: 1rem;">
            <div style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                <button class="btn @(VM.ActiveStrategy == "best-value" ? "btn-primary" : "btn-secondary")" @onclick="@(() => VM.LoadQuickRankingAsync("best-value"))" disabled="@VM.IsLoading">
                    🏆 Best Value
                </button>
                <button class="btn @(VM.ActiveStrategy == "cheapest" ? "btn-primary" : "btn-secondary")" @onclick="@(() => VM.LoadQuickRankingAsync("cheapest"))" disabled="@VM.IsLoading">
                    💰 Cheapest
                </button>
                <button class="btn @(VM.ActiveStrategy == "most-filling" ? "btn-primary" : "btn-secondary")" @onclick="@(() => VM.LoadQuickRankingAsync("most-filling"))" disabled="@VM.IsLoading">
                    🍔 Most Filling
                </button>
            </div>

            @if (VM.IsLoading)
            {
                <div class="spinner"></div>
            }
            else if (VM.QuickRankings != null && VM.QuickRankings.Any())
            {
                <div class="grid grid-3" style="margin-top: 1rem;">
                    @foreach (var (restaurant, index) in VM.QuickRankings.Take(6).Select((r, i) => (r, i + 1)))
                    {
                        <a @key="restaurant.Id" href="/restaurant/@restaurant.Id" style="text-decoration: none; color: inherit;">
                            <div class="restaurant-card fade-in" style="@($"animation-delay: {index * 0.05}s")">
                                <div class="rank-badge @VM.GetRankClass(index)">
                                    @index
                                </div>
                                <h3 class="restaurant-name">@restaurant.Name</h3>
                                <p class="restaurant-city">📍 @restaurant.City</p>
                                <span class="restaurant-type">@restaurant.DisplayIcon @restaurant.DisplayName</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
    </div>


@code {
    private bool _signalRStarted;

    protected override void OnInitialized() => VM.OnStateChanged += StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        VM.InvokeAsync = fn => InvokeAsync(fn);
        await VM.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_signalRStarted)
        {
            _signalRStarted = true;
            await VM.StartSignalRAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        VM.OnStateChanged -= StateHasChanged;
        await VM.DisposeAsync();
    }
}
