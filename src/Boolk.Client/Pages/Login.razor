@page "/login"
@namespace Boolk.Client.Pages
@inject LoginViewModel VM
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Login - Boolk</PageTitle>

<div class="container" style="display: flex; justify-content: center; align-items: center; min-height: 80vh; padding: 2rem;">
    <div class="card" style="max-width: 400px; width: 100%; padding: 2rem;">
        <div class="card-header">
            <h2 class="card-title">🔐 Login</h2>
        </div>

        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
            <EditForm Model="VM" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Email</label>
                    <InputText @bind-Value="VM.Email" type="email" class="form-control" placeholder="Enter your email" />
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Password</label>
                    <InputText @bind-Value="VM.Password" type="password" class="form-control" placeholder="Enter your password" />
                </div>

                @if (!string.IsNullOrEmpty(VM.ErrorMessage))
                {
                    <div class="text-danger">@VM.ErrorMessage</div>
                }

                <button class="btn btn-primary" type="submit" disabled="@VM.IsSubmitting" style="margin-top: 1rem;">
                    @(VM.IsSubmitting ? "Loading..." : "Login")
                </button>
            </EditForm>
        </div>

        <div class="card-footer" style="text-align: center; margin-top: 1rem;">
            <a href="/register" style="color: gray;">Don't have an account? Register</a>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => VM.OnStateChanged += StateHasChanged;
    public void Dispose() => VM.OnStateChanged -= StateHasChanged;

    private async Task HandleLogin()
    {
        if (await VM.LoginAsync())
            Nav.NavigateTo("/profile");
    }
}
