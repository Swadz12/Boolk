@page "/login"
@inject AuthApiClient AuthClient
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthStateProvider

<PageTitle>Login - Boolk</PageTitle>

<div class="container" style="display: flex; justify-content: center; align-items: center; min-height: 80vh; padding: 2rem;">
    <div class="card" style="max-width: 400px; width: 100%; padding: 2rem;">
        <div class="card-header">
            <h2 class="card-title">🔐 Login</h2>
        </div>

        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Email</label>
                    <InputText @bind-Value="loginModel.Email" type="email" class="form-control" placeholder="Enter your email" />
                </div>
                
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Password</label>
                    <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="Enter your password" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="text-danger">@errorMessage</div>
                }

                <button class="btn btn-primary" type="submit" disabled="@isSubmitting" style="margin-top: 1rem;">
                    @(isSubmitting ? "Loading..." : "Login")
                </button>
            </EditForm>
        </div>

        <div class="card-footer" style="text-align: center; margin-top: 1rem;">
            <a href="/register" style="color: gray;">Don't have an account? Register</a>
        </div>
    </div>
</div>

@code {
    private bool isSubmitting = false;
    private string errorMessage = "";
    private LoginModel loginModel = new();

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = "";
        try
        {
            var response = await AuthClient.LoginAsync(loginModel.Email, loginModel.Password);
            
            if (response?.Success == true)
            {
                AuthStateProvider.NotifyAuthenticationStateChanged();
                Nav.NavigateTo("/profile");
            }
            else
            {
                errorMessage = response?.Error ?? "Login failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    class LoginModel 
    { 
        public string Email { get; set; } = ""; 
        public string Password { get; set; } = ""; 
    }
}
