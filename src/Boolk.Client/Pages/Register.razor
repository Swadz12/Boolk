@page "/register"
@inject RegisterViewModel VM
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Register - Boolk</PageTitle>

<div class="container" style="display: flex; justify-content: center; align-items: center; min-height: 80vh; padding: 2rem;">
    <div class="card" style="max-width: 400px; width: 100%; padding: 2rem;">
        <div class="card-header">
            <h2 class="card-title">✨ Register</h2>
        </div>

        <div class="card-body">
            <EditForm Model="VM.FormModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Name</label>
                    <InputText @bind-Value="VM.FormModel.Name" class="form-control" placeholder="Enter your name" />
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Email</label>
                    <InputText @bind-Value="VM.FormModel.Email" type="email" class="form-control" placeholder="Enter your email" />
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Birth Date</label>
                    <InputDate @bind-Value="VM.FormModel.BirthDate" class="form-control" />
                    <ValidationMessage For="@(() => VM.FormModel.BirthDate)" style="color:red; font-size: 0.8rem;" />
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="margin-top: 0.5rem; margin-bottom: 0.5rem; display: block;">Password</label>
                    <InputText @bind-Value="VM.FormModel.Password" type="password" class="form-control" placeholder="Enter your password" />
                </div>

                @if (!string.IsNullOrEmpty(VM.ErrorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        @VM.ErrorMessage
                    </div>
                }

                <button class="btn btn-primary" type="submit" disabled="@VM.IsSubmitting" style="margin-top: 1rem; width: 100%;">
                    @(VM.IsSubmitting ? "Loading..." : "Register")
                </button>
            </EditForm>
        </div>

        <div class="card-footer" style="text-align: center; margin-top: 1rem; border-top: none; background: transparent;">
            <a href="/login" style="color: gray; text-decoration: none;">Already have an account? Login</a>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => VM.OnStateChanged += StateHasChanged;
    public void Dispose() => VM.OnStateChanged -= StateHasChanged;

    private async Task HandleRegister()
    {
        if (await VM.RegisterAsync())
            Nav.NavigateTo("/profile");
    }
}
