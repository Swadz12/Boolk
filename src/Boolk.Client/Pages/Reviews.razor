@page "/reviews"
@inject ReviewsViewModel VM
@implements IAsyncDisposable

<PageTitle>Reviews - Boolk</PageTitle>

<div class="hero" style="padding: 2rem;">
    <div class="hero-content">
        <h1 style="font-size: 2.5rem;">Restaurant Reviews</h1>
        <p>Share your dining experience and help others find great places</p>
    </div>
</div>

<div class="container mt-5">
    <div class="grid grid-2">
        <div class="card fade-in">
            <div class="card-header">
                <h2 class="card-title">⭐ Add New Review</h2>
            </div>
            @if (VM.CurrentUser == null)
            {
                <div class="alert alert-error">
                    🔒 You must be logged in to add a review
                    <br />
                    <a href="/login" style="color:#667eea; font-weight:600;">
                        Go to login
                    </a>
                </div>
            }
            else
            {
                <EditForm Model="@VM.NewReview" OnValidSubmit="@VM.SubmitReviewAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Restaurant:</label>
                        @if (VM.Restaurants != null && VM.Restaurants.Any())
                        {
                            <InputSelect @bind-Value="VM.SelectedRestaurantId" class="form-select">
                                <option value="">Select restaurant...</option>
                                @foreach (var restaurant in VM.Restaurants)
                                {
                                    <option @key="restaurant.Id" value="@restaurant.Id">@restaurant.Name - @restaurant.City</option>
                                }
                            </InputSelect>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Price (€):</label>
                        <InputNumber @bind-Value="VM.NewReview.Price"
                                     TValue="double"
                                     class="form-control"
                                     step="0.01"
                                     />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Satiety Level (1-10):</label>
                        <div>
                            @for (int i = 1; i <= 10; i++)
                            {
                                var value = i;
                                <span class="star"
                                      style="opacity:@(value <= VM.NewReview.SatietyLevel ? "1" : "0.3"); cursor:pointer;"
                                      @onclick="() => VM.SetSatiety(value)">
                                    ⭐
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Comment:</label>
                        <InputTextArea @bind-Value="VM.NewReview.Comment"
                                       class="form-control"
                                       rows="4" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@(VM.IsSubmitting || string.IsNullOrEmpty(VM.SelectedRestaurantId))"  style="margin-top: 1rem;">
                        @if (VM.IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <span>Submit Review</span>
                        }
                    </button>

                </EditForm>
            }


            @if (!string.IsNullOrEmpty(VM.Message))
            {
                <div class="alert @(VM.Message.Contains("Error") || VM.Message.Contains("Invalid") ? "alert-error" : "alert-success") mt-3">
                    @VM.Message
                </div>
            }
        </div>

        <div class="card fade-in" style="animation-delay: 0.1s">
            <div class="card-header">
                <h2 class="card-title">📊 Review Statistics</h2>
            </div>
            <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                <div class="stats-number">@VM.TotalReviews</div>
                <div class="stats-label">Total Reviews</div>
            </div>
            @if (VM.AveragePrice > 0)
            {
                <div style="margin-top: 1.5rem;">
                    <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                        <div class="stats-number" style="font-size: 1.5rem;">€@VM.AveragePrice.ToString("F2")</div>
                        <div class="stats-label">Average Price</div>
                    </div>
                </div>
            }
            @if (VM.AverageSatiety > 0)
            {
                <div style="margin-top: 1.5rem;">
                    <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                        <div class="stats-number" style="font-size: 1.5rem;">
                            @for (int i = 0; i < (int)Math.Round(VM.AverageSatiety); i++)
                            {
                                <span class="star">⭐</span>
                            }
                        </div>
                        <div class="stats-label">Average Satiety (@VM.AverageSatiety.ToString("F1")/10)</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (VM.Reviews != null && VM.Reviews.Any())
    {
        <div class="card mt-5 fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h2 class="card-title">💬 All Reviews</h2>
                <button class="btn btn-secondary" @onclick="VM.RefreshAsync" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                    🔄 Refresh
                </button>
            </div>
            <div style="padding: 1rem;">
                @foreach (var review in VM.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div @key="review.Id" class="review-card fade-in">
                        <div class="review-header">
                            <div>
                                <div style="font-weight: 600; margin-bottom: 0.25rem;">
                                    📍@VM.GetRestaurantName(review.RestaurantId)
                                </div>
                                <small style="color: var(--text-secondary);">
                                    👤 @review.UserName • 🕒 @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </small>

                            </div>
                            <div class="review-price">€@review.Price.ToString("F2")</div>
                        </div>
                        <div class="review-satiety" style="margin-bottom: 1rem;">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <span class="star" style="opacity: @(i <= review.SatietyLevel ? "1" : "0.2")">⭐</span>
                            }
                            <span style="margin-left: 0.5rem; color: var(--text-secondary);">(@review.SatietyLevel/10)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <p style="color: var(--text-primary); line-height: 1.6;">
                                "@review.Comment"
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (VM.Reviews != null && !VM.Reviews.Any())
    {
        <div class="card mt-5 fade-in" style="animation-delay: 0.2s">
            <div style="text-align: center; padding: 3rem;">
                <div style="font-size: 4rem; margin-bottom: 1rem;">⭐</div>
                <h3 style="margin-bottom: 1rem;">No reviews yet</h3>
                <p style="color: var(--text-secondary);">
                    Be the first to share your dining experience!
                </p>
            </div>
        </div>
    }
</div>

@code {
    private bool _firstRenderDone;
    private bool _signalRStarted;

    protected override void OnInitialized() => VM.OnStateChanged += StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_firstRenderDone)
        {
            _firstRenderDone = true;
            VM.InvokeAsync = fn => InvokeAsync(fn);
            await VM.InitializeAsync();

            if (!_signalRStarted)
            {
                _signalRStarted = true;
                await VM.StartSignalRAsync();
            }

            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        VM.OnStateChanged -= StateHasChanged;
        await VM.DisposeAsync();
    }
}
