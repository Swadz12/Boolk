@page "/reviews"
@inject RestaurantApiClient RestaurantClient
@inject ReviewApiClient ReviewClient
@inject AuthApiClient AuthClient
@inject RankingRealTimeService RealTimeService
@implements IAsyncDisposable

<PageTitle>Reviews - Boolk</PageTitle>

<div class="hero" style="padding: 2rem;">
    <div class="hero-content">
        <h1 style="font-size: 2.5rem;">Restaurant Reviews</h1>
        <p>Share your dining experience and help others find great places</p>
    </div>
</div>

<div class="container mt-5">
    <div class="grid grid-2">
        <!-- Add Review Form -->
        <div class="card fade-in">
            <div class="card-header">
                <h2 class="card-title">⭐ Add New Review</h2>
            </div>
            @if (currentUser == null)
            {
                <div class="alert alert-error">
                    🔒 You must be logged in to add a review
                    <br />
                    <a href="/login" style="color:#667eea; font-weight:600;">
                        Go to login
                    </a>
                </div>
            }
            else
            {
                <EditForm Model="@newReview" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Restaurant:</label>
                        @if (restaurants != null && restaurants.Any())
                        {
                            <InputSelect @bind-Value="selectedRestaurantId" class="form-select">
                                <option value="">Select restaurant...</option>
                                @foreach (var restaurant in restaurants)
                                {
                                    <option @key="restaurant.Id" value="@restaurant.Id">@restaurant.Name - @restaurant.City</option>
                                }
                            </InputSelect>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Price (€):</label>
                        <InputNumber @bind-Value="newReview.Price"
                                     TValue="double"
                                     class="form-control"
                                     step="0.01"
                                     />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Satiety Level (1-10):</label>
                        <div>
                            @for (int i = 1; i <= 10; i++)
                            {
                                var value = i;
                                <span class="star"
                                      style="opacity:@(value <= newReview.SatietyLevel ? "1" : "0.3"); cursor:pointer;"
                                      @onclick="() => SetSatiety(value)">
                                    ⭐
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="margin: 0.5rem; display: block;">Comment:</label>
                        <InputTextArea @bind-Value="newReview.Comment"
                                       class="form-control"
                                       rows="4" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@(isSubmitting || string.IsNullOrEmpty(selectedRestaurantId))"  style="margin-top: 1rem;">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <span>Submit Review</span>
                        }
                    </button>

                </EditForm>
            }


            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert @(message.Contains("Error") || message.Contains("Invalid") ? "alert-error" : "alert-success") mt-3">
                    @message
                </div>
            }
        </div>

        <!-- Review Stats -->
        <div class="card fade-in" style="animation-delay: 0.1s">
            <div class="card-header">
                <h2 class="card-title">📊 Review Statistics</h2>
            </div>
            <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                <div class="stats-number">@totalReviews</div>
                <div class="stats-label">Total Reviews</div>
            </div>
            @if (averagePrice > 0)
            {
                <div style="margin-top: 1.5rem;">
                    <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                        <div class="stats-number" style="font-size: 1.5rem;">€@averagePrice.ToString("F2")</div>
                        <div class="stats-label">Average Price</div>
                    </div>
                </div>
            }
            @if (averageSatiety > 0)
            {
                <div style="margin-top: 1.5rem;">
                    <div class="stats-card" style="background: transparent; border: none; padding: 0;">
                        <div class="stats-number" style="font-size: 1.5rem;">
                            @for (int i = 0; i < (int)Math.Round(averageSatiety); i++)
                            {
                                <span class="star">⭐</span>
                            }
                        </div>
                        <div class="stats-label">Average Satiety (@averageSatiety.ToString("F1")/10)</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Existing Reviews -->
    @if (reviews != null && reviews.Any())
    {
        <div class="card mt-5 fade-in" style="margin-top: 2rem;animation-delay: 0.2s">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h2 class="card-title">💬 All Reviews</h2>
                <button class="btn btn-secondary" @onclick="RefreshReviews" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                    🔄 Refresh
                </button>
            </div>
            <div style="padding: 1rem;">
                @foreach (var review in reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div @key="review.Id" class="review-card fade-in">
                        <div class="review-header">
                            <div>
                                <div style="font-weight: 600; margin-bottom: 0.25rem;">
                                    @GetRestaurantName(review.RestaurantId)
                                </div>
                                <small style="color: var(--text-secondary);">
                                    👤 @review.UserName • 🕒 @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </small>

                            </div>
                            <div class="review-price">€@review.Price.ToString("F2")</div>
                        </div>
                        <div class="review-satiety" style="margin-bottom: 1rem;">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <span class="star" style="opacity: @(i <= review.SatietyLevel ? "1" : "0.2")">⭐</span>
                            }
                            <span style="margin-left: 0.5rem; color: var(--text-secondary);">(@review.SatietyLevel/10)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <p style="color: var(--text-primary); line-height: 1.6;">
                                "@review.Comment"
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (reviews != null && !reviews.Any())
    {
        <div class="card mt-5 fade-in" style="animation-delay: 0.2s">
            <div style="text-align: center; padding: 3rem;">
                <div style="font-size: 4rem; margin-bottom: 1rem;">⭐</div>
                <h3 style="margin-bottom: 1rem;">No reviews yet</h3>
                <p style="color: var(--text-secondary);">
                    Be the first to share your dining experience!
                </p>
            </div>
        </div>
    }
</div>

@code {
    private NewReviewModel newReview = new();
    private string selectedRestaurantId = "";
    
    private string message = "";
    private bool isSubmitting = false;
    private bool firstRenderDone = false;
    private UserDto? currentUser;
    private List<RestaurantDto>? restaurants;
    private List<ReviewDto>? reviews;
    private int totalReviews = 0;
    private double averagePrice = 0;
    private decimal averageSatiety = 0;

    private bool _signalRStarted = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !firstRenderDone)
        {
            firstRenderDone = true;
            RealTimeService.OnRankingsUpdated += HandleRankingsUpdate;
            currentUser = await AuthClient.GetCurrentUserAsync();
            await LoadData();
            
            // Start SignalR connection
            if (!_signalRStarted)
            {
                _signalRStarted = true;
                try
                {
                    await RealTimeService.StartAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Reviews] SignalR connection failed: {ex.Message}");
                }
            }
            
            StateHasChanged();
        }
    }

    private void HandleRankingsUpdate(IEnumerable<RestaurantDto> rankings)
    {
        InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        RealTimeService.OnRankingsUpdated -= HandleRankingsUpdate;
        await RealTimeService.DisposeAsync();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await RestaurantClient.GetAllAsync(1, 1000);
            restaurants = result?.Items.ToList();
            reviews = (await ReviewClient.GetAllAsync())?.ToList();
            totalReviews = reviews?.Count ?? 0;
            
            if (reviews != null && reviews.Any())
            {
                averagePrice = reviews.Average(r => r.Price);
                averageSatiety = reviews.Average(r => (decimal)r.SatietyLevel);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        if (currentUser == null)
        {
            message = "❌ You must be logged in to add a review";
            return;
        }

        isSubmitting = true;
        message = "";
        StateHasChanged();

        try
        {
            if (Guid.TryParse(selectedRestaurantId, out var restaurantId))
            {
                await ReviewClient.CreateAsync(
                    restaurantId, 
                    currentUser.Id, 
                    newReview.Price, 
                    newReview.SatietyLevel, 
                    newReview.Comment);
                
                message = "✅ Review added successfully!";
                newReview = new NewReviewModel();
                selectedRestaurantId = "";
                
                await LoadData();
                
                await Task.Delay(1500);
                message = "";
            }
            else
            {
                message = "❌ Invalid Restaurant ID";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void SetSatiety(int value)
    {
        newReview.SatietyLevel = Math.Clamp(value, 1, 10);
    }

    private async Task RefreshReviews()
    {
        await LoadData();
    }

    private string GetRestaurantName(Guid restaurantId)
    {
        var restaurant = restaurants?.FirstOrDefault(r => r.Id == restaurantId);
        return restaurant != null ? $"📍{restaurant.Name} - {restaurant.City}" : "Unknown Restaurant";
    }

    class NewReviewModel
    {
        public double Price { get; set; } = 0;
        public int SatietyLevel { get; set; } = 5;
        public string Comment { get; set; } = "";
    }
}
